<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>VectraCore</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
:root {
  --bg:#07070f;--card:#0c0c18;--border:#151528;--border2:#1e1e3a;
  --cs:#00d9ff;--math:#b388ff;--food:#ffb74d;--sports:#69f0ae;--doc:#34d399;
  --accent:#6c63ff;--text:#cdd6f4;--muted:#4a4a6a;--red:#f38ba8;--green:#a6e3a1;
}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:var(--text);font-family:'Fira Code','Courier New',monospace;height:100vh;overflow:hidden;display:flex;flex-direction:column}

header{background:var(--card);border-bottom:1px solid var(--border);padding:10px 20px;display:flex;align-items:center;gap:10px;flex-shrink:0}
.logo{font-size:16px;font-weight:600;letter-spacing:5px;background:linear-gradient(90deg,var(--cs),var(--accent),var(--math));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.badge{font-size:9px;padding:2px 8px;border-radius:20px;border:1px solid var(--border2);color:var(--muted);letter-spacing:1px}
.badge.hl{border-color:rgba(108,99,255,.4);color:var(--accent);background:rgba(108,99,255,.08)}
.badge.ok{border-color:rgba(166,227,161,.3);color:var(--green);background:rgba(166,227,161,.07)}
.badge.err{border-color:rgba(243,139,168,.3);color:var(--red);background:rgba(243,139,168,.07)}
#statsLabel{margin-left:auto;font-size:10px;color:var(--muted)}

.layout{display:flex;flex:1;overflow:hidden}

/* LEFT — ASK AI */
.left-panel{width:320px;flex-shrink:0;background:var(--card);border-right:1px solid var(--border);display:flex;flex-direction:column;overflow:hidden}
.panel-header{padding:14px 16px 10px;border-bottom:1px solid var(--border);font-size:9px;letter-spacing:2px;color:var(--muted);text-transform:uppercase;display:flex;align-items:center;gap:8px}
.panel-header::before{content:'';display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--accent)}
.ask-controls{padding:14px 16px;display:flex;flex-direction:column;gap:8px;border-bottom:1px solid var(--border);flex-shrink:0}
textarea,input[type=text],select{width:100%;background:rgba(0,0,0,.35);border:1px solid var(--border2);color:var(--text);padding:9px 11px;border-radius:6px;font-family:inherit;font-size:11px;outline:none;transition:border-color .2s}
textarea:focus,input[type=text]:focus,select:focus{border-color:var(--accent)}
textarea{resize:none;line-height:1.6}
select option{background:#0c0c18}
.ask-row{display:flex;gap:7px;align-items:center}
.ask-row select{width:auto;flex-shrink:0}
button{padding:8px 14px;border:none;border-radius:6px;cursor:pointer;font-family:inherit;font-size:11px;font-weight:500;letter-spacing:.5px;transition:all .18s;width:100%}
.btn-p{background:linear-gradient(135deg,var(--accent),#4f46e5);color:#fff;box-shadow:0 0 16px rgba(108,99,255,.25)}
.btn-p:hover{box-shadow:0 0 26px rgba(108,99,255,.5);transform:translateY(-1px)}
.btn-p:disabled{opacity:.4;transform:none;cursor:not-allowed}
.btn-g{background:rgba(166,227,161,.1);color:var(--green);border:1px solid rgba(166,227,161,.25)}
.btn-g:hover{background:rgba(166,227,161,.2)}
.btn-g:disabled{opacity:.4;cursor:not-allowed}
.btn-s{background:var(--border2);color:var(--text)}
.btn-s:hover{background:#252545}
.btn-s:disabled{opacity:.4;cursor:not-allowed}
.btn-danger{background:rgba(243,139,168,.1);color:var(--red);border:1px solid rgba(243,139,168,.2)}
.btn-danger:hover{background:rgba(243,139,168,.2)}
.hint{font-size:9px;color:var(--muted);text-align:center}
.chat-scroll{flex:1;overflow-y:auto;padding:14px 16px;display:flex;flex-direction:column;gap:10px}
.chat-q{background:rgba(108,99,255,.1);border:1px solid rgba(108,99,255,.2);border-left:3px solid var(--accent);border-radius:6px;padding:9px 11px;font-size:11px;line-height:1.6}
.chat-a{background:rgba(0,0,0,.3);border:1px solid var(--border2);border-left:3px solid var(--green);border-radius:6px;padding:11px}
.chat-a-label{font-size:8px;letter-spacing:2px;color:var(--doc);margin-bottom:5px;text-transform:uppercase}
.chat-a-text{font-size:11px;line-height:1.8;white-space:pre-wrap}
.chat-ctx{margin-top:8px;border-top:1px solid var(--border);padding-top:7px}
.chat-ctx-label{font-size:8px;letter-spacing:1px;color:var(--muted);margin-bottom:5px;text-transform:uppercase}
.ctx-chip{display:inline-block;font-size:8px;padding:2px 7px;border-radius:20px;margin:2px;background:rgba(108,99,255,.08);border:1px solid rgba(108,99,255,.18);color:var(--accent);cursor:pointer;transition:background .15s}
.ctx-chip:hover{background:rgba(108,99,255,.2)}
.ctx-expand{display:none;font-size:9px;color:var(--muted);line-height:1.6;margin-top:5px;padding:7px;background:rgba(0,0,0,.4);border-radius:4px}
.thinking{display:flex;align-items:center;gap:7px;font-size:10px;color:var(--muted)}
.spinner{width:12px;height:12px;border:2px solid var(--border2);border-top-color:var(--accent);border-radius:50%;animation:spin .7s linear infinite;flex-shrink:0}
@keyframes spin{to{transform:rotate(360deg)}}
.typing::after{content:'▋';animation:blink 1s step-end infinite}
@keyframes blink{50%{opacity:0}}
.empty-chat{color:var(--muted);font-size:10px;text-align:center;margin-top:30px;line-height:1.8}

  .scatter-panel { flex:1; min-width:380px; position:relative; overflow:hidden; border-right:1px solid var(--border); background:var(--bg); }
  #scatter { display:block; width:100%; height:100%; }

/* CENTER — LIBRARY + SEARCH */
.center-panel{flex:1;display:flex;flex-direction:column;overflow:hidden;border-right:1px solid var(--border)}
.center-tabs{display:flex;border-bottom:1px solid var(--border);flex-shrink:0}
.ctab{flex:1;padding:10px 6px;text-align:center;font-size:9px;letter-spacing:1.5px;cursor:pointer;color:var(--muted);border-bottom:2px solid transparent;transition:all .2s;text-transform:uppercase}
.ctab.on{color:var(--accent);border-bottom-color:var(--accent)}

/* LIBRARY TAB */
.library-pane{flex:1;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:12px}
.library-pane.hidden,.search-pane.hidden{display:none}
.upload-zone{border:2px dashed var(--border2);border-radius:10px;padding:32px 20px;text-align:center;cursor:pointer;transition:all .22s;position:relative}
.upload-zone:hover,.upload-zone.drag{border-color:var(--accent);background:rgba(108,99,255,.05)}
.upload-zone .uz-icon{font-size:32px;margin-bottom:10px;opacity:.4}
.upload-zone .uz-title{font-size:12px;color:var(--text);margin-bottom:5px}
.upload-zone .uz-sub{font-size:10px;color:var(--muted)}
.upload-zone input{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%}
.upload-status{font-size:10px;padding:8px 12px;background:rgba(108,99,255,.08);border:1px solid rgba(108,99,255,.2);border-radius:6px;display:none;align-items:center;gap:8px}
.upload-status.show{display:flex}
.lib-header{display:flex;align-items:center;justify-content:space-between}
.lib-title{font-size:9px;letter-spacing:2px;color:var(--muted);text-transform:uppercase}
.clear-btn{font-size:9px;padding:3px 10px;width:auto;background:rgba(243,139,168,.08);color:var(--red);border:1px solid rgba(243,139,168,.2);border-radius:4px;cursor:pointer;font-family:inherit;transition:background .15s}
.clear-btn:hover{background:rgba(243,139,168,.18)}
.doc-list{display:flex;flex-direction:column;gap:7px}
.dcard{background:var(--card);border:1px solid var(--border2);border-left:3px solid var(--doc);border-radius:7px;padding:10px 12px;animation:fu .22s ease}
@keyframes fu{from{opacity:0;transform:translateY(-3px)}to{opacity:1;transform:translateY(0)}}
.dcard-title{font-size:11px;font-weight:500;color:var(--doc);margin-bottom:3px}
.dcard-preview{font-size:9px;color:var(--muted);line-height:1.6;margin-bottom:6px}
.dcard-foot{display:flex;justify-content:space-between;align-items:center}
.dcard-meta{font-size:8px;color:var(--muted)}
.del{background:rgba(243,139,168,.1);color:var(--red);border:1px solid rgba(243,139,168,.2);border-radius:4px;cursor:pointer;font-size:9px;padding:2px 7px;font-family:inherit;transition:background .15s;width:auto}
.del:hover{background:rgba(243,139,168,.22)}
.empty-lib{text-align:center;padding:40px 20px;color:var(--muted);font-size:11px;line-height:2}
.empty-icon{font-size:36px;opacity:.2;margin-bottom:10px}

/* TEXT INSERT */
.text-insert{background:var(--card);border:1px solid var(--border2);border-radius:8px;padding:12px;display:flex;flex-direction:column;gap:7px}
.text-insert-label{font-size:9px;letter-spacing:2px;color:var(--muted);text-transform:uppercase}

/* SEARCH TAB */
.search-pane{flex:1;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:14px}
.sec{font-size:9px;letter-spacing:2px;text-transform:uppercase;color:var(--muted);margin-bottom:7px;display:flex;align-items:center;gap:6px}
.sec::after{content:'';flex:1;height:1px;background:var(--border)}
.search-input-row{display:flex;flex-direction:column;gap:6px}
.algo-row{display:flex;gap:4px}
.algo-btn{flex:1;padding:7px 3px;border-radius:5px;border:1px solid var(--border2);background:transparent;color:var(--muted);font-size:9px;cursor:pointer;text-align:center;transition:all .18s;letter-spacing:.5px;font-family:inherit}
.algo-btn.on{border-color:var(--accent);color:var(--accent);background:rgba(108,99,255,.1)}
input[type=range]{width:100%;accent-color:var(--accent);background:transparent;border:none;padding:0}
.results{display:flex;flex-direction:column;gap:6px}
.rcard{background:rgba(0,0,0,.3);border:1px solid var(--border2);border-radius:7px;padding:9px 11px;animation:fu .22s ease}
.rcard:hover{border-color:#252550}
.rrank{font-size:8px;color:var(--muted);letter-spacing:1px;margin-bottom:2px}
.rmeta{font-size:11px;line-height:1.5;margin-bottom:5px}
.rfoot{display:flex;align-items:center;gap:5px}
.rcat{font-size:8px;padding:2px 6px;border-radius:20px;letter-spacing:.5px}
.rdist{font-size:9px;color:var(--muted);flex:1;text-align:right}
.lat-big{font-size:28px;font-weight:600;color:var(--cs)}
.lat-sub{font-size:10px;color:var(--muted);margin-top:2px}
.bench{display:flex;flex-direction:column;gap:8px}
.brow{display:flex;flex-direction:column;gap:3px}
.blabel{display:flex;justify-content:space-between;font-size:9px}
.btrack{height:6px;background:rgba(0,0,0,.3);border-radius:3px;overflow:hidden}
.bfill{height:100%;border-radius:3px;transition:width .5s ease}
#vecCvs{display:block;width:100%;background:rgba(0,0,0,.3);border-radius:5px}

/* RIGHT — STATUS */
.right-panel{width:280px;flex-shrink:0;background:var(--card);display:flex;flex-direction:column;overflow-y:auto;padding:14px;gap:14px}
.status-card{background:rgba(0,0,0,.3);border:1px solid var(--border2);border-radius:8px;padding:11px 13px;font-size:10px;line-height:1.8}
.status-card.ok{border-color:rgba(166,227,161,.25)}
.status-card.err{border-color:rgba(243,139,168,.25)}
.stat-row{display:flex;justify-content:space-between;align-items:center;font-size:10px;padding:3px 0;border-bottom:1px solid var(--border)}
.stat-row:last-child{border-bottom:none}
.stat-label{color:var(--muted)}
.stat-val{color:var(--text);font-weight:500}
.layers{display:flex;flex-direction:column;gap:4px}
.lrow{display:flex;align-items:center;gap:6px;font-size:9px}
.lnum{width:16px;text-align:right;color:var(--accent)}
.ltrack{flex:1;height:4px;background:rgba(0,0,0,.3);border-radius:2px;overflow:hidden}
.lfill{height:100%;background:var(--accent);border-radius:2px;opacity:.65;transition:width .4s}
.lcount{width:72px;text-align:right;color:var(--muted)}
.algo-info{display:flex;flex-direction:column;gap:6px}
.algo-info-row{background:rgba(0,0,0,.2);border-radius:5px;padding:8px 10px}
.algo-info-name{font-size:9px;color:var(--accent);letter-spacing:1px;margin-bottom:3px}
.algo-info-desc{font-size:9px;color:var(--muted);line-height:1.5}

#tip{position:fixed;display:none;background:var(--card);border:1px solid var(--border2);border-radius:6px;padding:6px 10px;font-size:10px;pointer-events:none;max-width:200px;z-index:200;line-height:1.5}
::-webkit-scrollbar{width:2px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:var(--border2);border-radius:2px}
</style>
</head>
<body>

<header>
  <div class="logo">VECTRACORE</div>
  <span class="badge hl">HNSW</span>
  <span class="badge">KD-TREE</span>
  <span class="badge">BRUTE FORCE</span>
  <span class="badge" id="ollamaBadge">OLLAMA…</span>
